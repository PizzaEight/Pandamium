{
	"type": "minecraft:multi_action",
	"title": "Help Menu",
	"external_title": "Help Menu",
	"body": {
		"type": "minecraft:plain_message",
		"contents": [
			{
          "text": "The Help Menu can be accessed via /trigger help or throught the Guidebook",
