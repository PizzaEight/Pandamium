				"type": "minecraft:run_command",
				"command": "trigger help set 4"
			}
		},
		{
			"label": "Commands",
			"action": {
				"type": "minecraft:run_command",
				"command": "trigger help set 5"
			}
		},
		{
			"label": "Ranks",
			"action": {
				"type": "minecraft:run_command",
				"command": "trigger help set 6"
			}
		},
		{
			"label": "Voting & Rewards",
			"action": {
				"type": "minecraft:run_command",
				"command": "trigger help set 7"
			}
		},
		{
