            "\n\n",
            {
                "text": "/trigger namehome",
                "color": "white"
            },
            "\n",
            {
                "text": "  Allows you to set a custom name for your home.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger delhome",
                "color": "white"
            },
            "\n",
            {
                "text": "  Deletes a specific home.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger options",
                "color": "white"
            },
            "\n",
            {
                "text": " Manage your options on the server to customize your experience.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger respawn",
                "color": "white"
            },
            "\n",
            {
                "text": "  Instantly kills you to return to your spawn point.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger mail",
                "color": "white"
            },
            "\n",
            {
                "text": "  Send items/messages to offline players.",
