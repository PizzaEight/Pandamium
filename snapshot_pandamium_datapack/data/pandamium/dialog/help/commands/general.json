            },
            "\n",
            {
                "text": "  Makes you sit on the ground.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger guidebook",
                "color": "white"
            },
            "\n",
            {
                "text": "  Gives you a guidebook to the server.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger parkour",
                "color": "white"
            },
            "\n",
            {
                "text": "  See your Parkour times and teleport options.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger parkour.quit",
                "color": "white"
