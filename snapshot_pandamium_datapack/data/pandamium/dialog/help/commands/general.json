            "\n\n",
            {
                "text": "/trigger parkour.warp.Forgotten_Caverns",
                "color": "white"
            },
            "\n",
            {
                "text": "  Teleport to the Forgotten Caverns parkour.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger parkour.warp.Jack_o_Giggle",
                "color": "white"
            },
            "\n",
            {
                "text": "  Teleport to the Jack o' Giggle parkour.",
                "color": "gray"
            }
