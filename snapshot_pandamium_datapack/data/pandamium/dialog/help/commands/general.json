"color": "gold"
}
},
{
"type": "minecraft:plain_message",
"contents": [
{
"text": "/trigger rtp",
"color": "white"
},
"\n",
{
"text": "  Randomly teleports you into the wilderness.",
"color": "gray"
},
            "\n\n",
            {
                "text": "/trigger tpa",
                "color": "white"
            },
            "\n",
            {
                "text": "  Request to teleport to someone.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger spawn",
                "color": "white"
            },
            "\n",
            {
                "text": "  Teleports you to the server spawn.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger enderman_farm",
                "color": "white"
            },
            "\n",
            {
                "text": "  Teleport to the public Enderman farm in the End.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger sethome",
                "color": "white"
            },
            "\n",
            {
                "text": "  Sets a new home at your current location.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger home",
                "color": "white"
            },
            "\n",
            {
                "text": "  Teleports you to your home (or a specific home ID).",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger homes",
                "color": "white"
