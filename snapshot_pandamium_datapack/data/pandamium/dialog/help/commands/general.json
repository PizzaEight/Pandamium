            },

            "\n\n",
            {
                "text": "/trigger vote",
                "color": "white"
            },
            "\n",
            {
                "text": "  Get links to the voting websites.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger vote_shop",
                "color": "white"
            },
            "\n",
            {
                "text": "  Opens the reward shop where you can buy items with vote credits.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger gift",
                "color": "white"
            },
            "\n",
            {
                "text": "  Gift a vote credit to another player.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger clear_inventory",
                "color": "white"
            },
            "\n",
            {
                "text": "  Clears your current inventory.",
                "color": "gray"
            },

            "\n\n",
            {
                "text": "/trigger afk",
                "color": "white"
            },
            "\n",
            {
                "text": "  Makes you appear AFK in tab.",
