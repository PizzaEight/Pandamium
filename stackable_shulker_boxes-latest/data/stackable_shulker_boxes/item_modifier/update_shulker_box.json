{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "#stackable_shulker_boxes:shulker_boxes",
        "predicates": {
            "minecraft:container": {
                "items": {
                    "size": 0
                }
            }
        }
    },
    "on_pass": {
        "type": "minecraft:set_components",
        "components": {
            "minecraft:max_stack_size": 64
        }
    }
}
